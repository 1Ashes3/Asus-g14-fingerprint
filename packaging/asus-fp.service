[Unit]
Description=ASUS fingerprint unlock service (Goodix 27c6:521d)
Documentation=file:@OPT@/README.md
After=systemd-udevd.service
Wants=systemd-udevd.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=asus-fp
Group=asus-fp
ExecStart=@OPT@/bin/asus-fp-daemon
Restart=always
RestartSec=2
RuntimeDirectory=asus-fp
RuntimeDirectoryMode=0755
# Enrollment credentials are added by /etc/systemd/system/asus-fp.service.d/10-enrollments.conf
# (LoadCredentialEncrypted=enroll-<user>:/var/lib/asus-fp/<user>.cred), decrypted by systemd into
# $CREDENTIALS_DIRECTORY, readable only by this service.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
DeviceAllow=char-usb_device rw
UMask=0077

[Install]
WantedBy=multi-user.target
